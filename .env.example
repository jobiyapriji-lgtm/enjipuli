# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (local development — default)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production — swap provider in prisma/schema.prisma too)
# Neon / Supabase with PgBouncer connection pooling:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"   # needed for migrations on Neon

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# Full URL of your deployment (no trailing slash).
# For local dev: http://localhost:3000
# For production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ─── Email domain restriction ─────────────────────────────────────────────────
# Leave blank ("") to allow all valid emails (e.g. Gmail, Providence, etc.).
# Set to specific domains (e.g. "student.providence.edu.in,providence.edu.in") and
# set RESTRICT_EMAIL_DOMAIN="true" if you want strict domain locking.
ALLOWED_EMAIL_DOMAIN=""

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Use rzp_test_* keys for testing; rzp_live_* for production.
# When mock keys are used the signature check is skipped automatically.
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# ─── Vendor Credentials ───────────────────────────────────────────────────────
VENDOR_EMAILS="vendor@enjipuli.com"
VENDOR_DEFAULT_PASSWORD="Enjipuli@2026"
